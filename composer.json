{
    "name": "stezkoy/flarum-audex",
    "type": "flarum-extension",
    "description": "Per-block script injection into the page head or before the closing body tag, omitted for selected users and groups. Ads, analytics, widgets — any HTML/JS.",
    "license": "MIT",
    "authors": [
        {
            "name": "Stezkoy",
            "email": "stezko@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/Stezkoy/flarum-audex",
        "issues": "https://github.com/Stezkoy/flarum-audex/issues"
    },
    "require": {
        "flarum/core": "^2.0",
        "php": "^8.3"
    },
    "suggest": {
        "fof/forum-widgets-core": "Enables the 'Widget' placement (blocks rendered in fof widget zones)"
    },
    "autoload": {
        "psr-4": {
            "Stezkoy\\FlarumAudex\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Audex",
            "category": "feature",
            "icon": {
                "name": "fas fa-bullhorn",
                "backgroundColor": "#00a185",
                "color": "#fff"
            }
        }
    }
}
